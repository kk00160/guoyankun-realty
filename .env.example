# 這個專案預設不需要任何金鑰。
# 預約資料只會寫到 data/appointments.json，確認信只產生本機 HTML 預覽，不會真的寄出。

# 線上預約系統與 /admin 後台的總開關，預設關閉。
#
# 只有在「資料改存雲端資料庫」且「後台補上登入驗證」之後，
# 正式站才可以設成 true。原因：
#   1. 目前預約寫入本機檔案，雲端平台檔案系統唯讀且不持久 → 客戶預約會遺失
#   2. /admin 目前沒有密碼 → 開著等於公開客戶姓名、電話、Email
#
# 本機開發請在 .env.local 設 BOOKING_ENABLED=true
BOOKING_ENABLED=false

# 後台 /admin 的登入密碼（HTTP Basic，帳號可任意填）。
# 沒設定就一律擋住，避免忘了設等於門戶大開。
# 真正的密碼只能放在 .env.local 或雲端平台的環境變數，絕對不要寫進這個檔案。
ADMIN_PASSWORD=


# ===============================================================
# 帶看助手（案源庫 → 買方勾選 → 路線 → 帶看單）
# ===============================================================

# 帶看系統的總開關，跟上面的預約系統各自獨立。
# 刻意分成兩個開關：預約系統的資料還存在本機檔案（不能上正式站），
# 但帶看系統走雲端資料庫，可以先單獨上線，不必被預約系統連坐。
#
# 設成 true 之前必須先滿足兩件事：
#   1. 下面的 SUPABASE_* 兩個變數都填好，且 supabase/schema.sql 已經跑過
#   2. 上面的 ADMIN_PASSWORD 已經設定（否則案源庫與買方個資等於公開）
TOUR_ENABLED=false

# Supabase 專案網址，長得像 https://xxxxxxxxxxxx.supabase.co
# 位置：Supabase 主控台 → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase 的 service_role key（不是 anon key）。
#
# ⚠️ 這把鑰匙可以繞過所有資料表權限，等於資料庫的萬用鑰匙。
#    只能放在 .env.local 或 Vercel 的環境變數，絕對不要寫進這個檔案、
#    不要提交進 Git、不要出現在任何 "use client" 的檔案裡。
#    src/lib/db.ts 開頭的 import "server-only" 就是在擋這件事。
#
# 位置：Supabase 主控台 → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
